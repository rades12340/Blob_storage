{
  "name": "js_practice",
  "module": "src/app.ts",
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.6.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{ts,js,json,css}": "biome check --write --no-errors-on-unmatched"
  },
  "private": true,
  "scripts": {
    "dev": "bun --watch src/app.ts",
    "prepare": "husky",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "type": "module"
}
